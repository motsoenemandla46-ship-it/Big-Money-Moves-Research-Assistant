:root {
  --bg: #0b0d11;
  --bg-soft: #12171d;
  --panel: rgba(20, 26, 33, 0.92);
  --panel-border: rgba(255, 255, 255, 0.08);
  --text: #edf2f7;
  --muted: #a7b0bb;
  --gold: #d8b976;
  --gold-soft: #f0d69a;
  --accent: #2287ff;
  --danger: #ff7c7c;
  --shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  background:
    radial-gradient(circle at top, rgba(216, 185, 118, 0.12), transparent 30%),
    linear-gradient(180deg, #090b0f 0%, #0b0d11 100%);
  color: var(--text);
  font-family: Inter, 'Segoe UI', sans-serif;
}

body {
  min-height: 100vh;
}

button, input, textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.page-shell {
  max-width: 1600px;
  margin: 0 auto;
  padding: 28px 20px 40px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 22px;
}

.eyebrow {
  margin: 0 0 8px;
  letter-spacing: 0.16em;
  color: var(--gold-soft);
  font-size: 11px;
  font-weight: 700;
}

h1 {
  margin: 0;
  font-size: clamp(2rem, 2vw, 2.6rem);
}

.layout {
  display: grid;
  grid-template-columns: 360px 1fr;
  gap: 22px;
  align-items: start;
}

.panel {
  background: var(--panel);
  border: 1px solid var(--panel-border);
  border-radius: 18px;
  box-shadow: var(--shadow);
}

.sidebar {
  padding: 18px;
  position: sticky;
  top: 20px;
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 16px;
}

label {
  color: var(--muted);
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

input, textarea {
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.02);
  box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.02);
  color: var(--text);
  padding: 12px 14px;
  width: 100%;
}

textarea {
  min-height: 96px;
  resize: vertical;
}

.primary, .secondary, .ghost {
  border: 0;
  border-radius: 12px;
  padding: 12px 16px;
  font-weight: 700;
}

.primary {
  width: 100%;
  background: linear-gradient(135deg, var(--gold), var(--gold-soft));
  color: #0e1115;
  box-shadow: 0 10px 25px rgba(216, 185, 118, 0.35);
}

.primary:disabled {
  opacity: 0.75;
  cursor: wait;
}

.secondary, .ghost {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.05);
  color: var(--text);
}

.progress-block {
  margin-top: 18px;
}

.progress-labels {
  display: flex;
  justify-content: space-between;
  color: var(--muted);
  font-size: 0.8rem;
  margin-bottom: 8px;
}

.progress-bar {
  width: 100%;
  height: 10px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.progress-bar span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--gold), var(--accent));
}

.content {
  min-width: 0;
}

.meta-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 18px 20px;
  margin-bottom: 18px;
}

.meta-label {
  display: block;
  font-size: 0.72rem;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 6px;
}

.meta-bar h2 {
  margin: 0;
  font-size: 1.3rem;
}

.meta-bar p {
  margin: 0;
  color: var(--muted);
}

.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 18px;
}

.tab {
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.02);
  color: var(--muted);
  border-radius: 999px;
  padding: 10px 14px;
  font-size: 0.78rem;
}

.tab.active {
  background: rgba(216, 185, 118, 0.12);
  border-color: rgba(216, 185, 118, 0.3);
  color: var(--gold-soft);
}

.content-body {
  min-height: 620px;
}

.panel h3 {
  margin-top: 0;
  margin-bottom: 16px;
  font-size: 1.6rem;
}

.panel {
  padding: 22px 24px;
}

.panel p {
  color: var(--text);
  line-height: 1.7;
  margin: 0;
}

.list {
  margin: 0;
  padding-left: 20px;
  display: grid;
  gap: 10px;
  color: var(--text);
  line-height: 1.6;
}

.list.numbered {
  list-style: decimal;
  padding-left: 24px;
}

.cards {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 14px;
}

.card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 14px;
  padding: 16px;
}

.card strong {
  display: block;
  margin-bottom: 10px;
  color: var(--gold-soft);
  font-size: 1.05rem;
}

.card p, .card small {
  display: block;
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.table-wrap {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

th, td {
  text-align: left;
  vertical-align: top;
  padding: 12px 10px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

th {
  color: var(--gold-soft);
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.visual-block {
  margin-top: 18px;
}

.visual-block h4 {
  margin: 0 0 8px;
  color: var(--gold-soft);
  text-transform: capitalize;
}

.research-pack {
  display: grid;
  gap: 18px;
}

@media (max-width: 980px) {
  .layout {
    grid-template-columns: 1fr;
  }

  .sidebar {
    position: static;
  }

  .meta-bar {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media (max-width: 560px) {
  .page-shell {
    padding-left: 12px;
    padding-right: 12px;
  }

  .panel {
    padding: 18px;
  }

  .topbar {
    align-items: flex-start;
    flex-direction: column;
  }
}
